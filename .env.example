# Copy to .env.local if you need to change anything. Every setting is optional.
#
# The app has no Gemini API key of its own: each visitor adds theirs in the app
# (Settings → Gemini API key), and it stays in their browser.

# Any Gemini model that supports structured (JSON schema) output.
GEMINI_MODEL=gemini-3.8-flash

# Optional: ID of a Vercel Firewall rate-limit rule (shared across all instances).
AI_RATE_LIMIT_ID=

# Optional: per-IP requests per minute enforced inside each server instance.
AI_REQUESTS_PER_MINUTE=10

# Developers only: your own key for `pnpm verify:ai`. The app never reads it.
GEMINI_TEST_API_KEY=
